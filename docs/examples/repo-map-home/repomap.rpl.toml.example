# Future autogenerated local setup config template.
# A future setup command may create REPOMAP_HOME/repomap.rpl.toml from this
# shape. MCP-RUNTIME1 never writes it into a real home directory.

schema_version = 1

[runtime]
container_runtime = "docker"
server_host_port = 55880
bind_host = "127.0.0.1"

[runtime.postgres]
direct_host_port_enabled = false
host_port = 55432
bind_host = "127.0.0.1"

[postgres]
host = "postgres"
port = 5432
database = "repomap"
user = "repomap"
password_env = "REPOMAP_PG_PASSWORD"
