# Claude harness state is local-only; keep the tracked skill projection
# catalog (.claude/skills) trackable. Do not ignore .agents/skills.
.claude/*
!.claude/skills

# Keep explicit examples and templates trackable.
!.env.example

# Keep explicit test fixtures trackable even when matching ignored directory names.
!src/test/fixtures/**/node_modules/
!src/test/fixtures/**/node_modules/**
